# Optional Phase 5 question interpretation (server-only).
# Leave all blank for the default deterministic rules-based fallback.
# Never commit real credentials. Do not use NEXT_PUBLIC_ variables.

# Full OpenAI-compatible chat-completions URL (HTTPS recommended).
THESISTRAIL_LLM_ENDPOINT=

# Model identifier accepted by that endpoint.
